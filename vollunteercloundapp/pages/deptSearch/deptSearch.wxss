/* pages/deptSearch/deptSearch.wxss */
.container {
  padding: 20rpx;
}

.search-section {
  margin-top: 20rpx;
}

.input {
  border: 1rpx solid #ddd;
  border-radius: 5rpx;
  padding: 15rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.button {
  background-color: #1A73E8;
  color: #fff;
  border-radius: 5rpx;
  padding: 15rpx;
  text-align: center;
  font-size: 28rpx;
}

.result-section {
  margin-top: 30rpx;
}

.result-card {
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}

.result-label {
  font-size: 28rpx;
  color: #666;
}

.result-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A73E8;
  margin-left: 10rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #333;
  margin-top: 15rpx;
  display: block;
}

.history-section {
  margin-top: 30rpx;
}

.history-list {
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.history-item:last-child {
  border-bottom: none;
}

.delete-btn {
  color: #999;
  font-size: 32rpx;
}