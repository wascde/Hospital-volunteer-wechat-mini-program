<!-- pages/deptSearch/deptSearch.wxml -->
<view class="container">
  <view class="card">
    <text class="title">科室查询</text>
    <view class="search-section">
      <input 
        class="input" 
        placeholder="请输入症状或疾病名称" 
        bindinput="onInput"
        value="{{searchText}}"
      />
      <button class="button" bindtap="searchDept">查询</button>
    </view>
  </view>

  <view wx:if="{{searchResult}}" class="result-section">
    <text class="title">查询结果</text>
    <view class="result-card">
      <text class="result-label">建议就诊科室：</text>
      <text class="result-value">{{searchResult.deptName}}</text>
      <text class="result-desc">
        {{searchResult.deptDesc}}
      </text>
    </view>
  </view>

  <view wx:if="{{recentSearches.length > 0}}" class="history-section">
    <text class="title">最近查询</text>
    <view class="history-list">
      <view 
        class="history-item" 
        wx:for="{{recentSearches}}" 
        wx:key="index"
        bindtap="onHistoryTap"
        data-keywords="{{item}}"
      >
        <text>{{item}}</text>
        <text class="delete-btn" bindtap="deleteHistory" data-index="{{index}}">×</text>
      </view>
    </view>
  </view>
</view>