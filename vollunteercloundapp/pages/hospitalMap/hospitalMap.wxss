/* ========== 页面容器 ========== */
.container {
  padding: 0;
  min-height: 100vh;
  background-color: #f0f4f8;
}

/* ========== 楼层选择器 ========== */
.floor-selector {
  display: flex;
  background-color: #fff;
  padding: 16rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 0;
  z-index: 10;
  overflow-x: auto;
}

.floor-tab {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background-color: #f3f4f6;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.floor-tab.active {
  background-color: #1A73E8;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.3);
}

.floor-tab-name {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.floor-tab.active .floor-tab-name {
  color: #fff;
}

/* ========== 平面图容器 ========== */
.floor-plan {
  padding: 20rpx;
}

.floor-header {
  margin-bottom: 16rpx;
}

.floor-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
}

.floor-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
  display: block;
}

/* ========== 地图区域 ========== */
.map-area {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  padding: 20rpx;
  position: relative;
}

.map-grid {
  position: relative;
  width: 100%;
  /* 宽高比约 3:4，用 padding-bottom 撑开 */
  padding-bottom: 130%;
  background-color: #fafbfc;
  border-radius: 8rpx;
  border: 2rpx solid #e5e7eb;
  /* 网格背景 */
  background-image:
    linear-gradient(rgba(209, 213, 219, 0.3) 1px, transparent 1px),
    linear-gradient(90deg, rgba(209, 213, 219, 0.3) 1px, transparent 1px);
  background-size: 6.25% 6.25%;
}

/* ========== 房间块 ========== */
.room-block {
  position: absolute;
  border-radius: 8rpx;
  border: 2rpx solid;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  box-sizing: border-box;
  z-index: 2;
}

.room-block:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.room-block.selected {
  transform: scale(1.04);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  z-index: 3;
}

.room-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
  line-height: 1.3;
  padding: 0 4rpx;
  word-break: break-all;
}

.room-type-tag {
  font-size: 16rpx;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-top: 6rpx;
  white-space: nowrap;
  opacity: 0.9;
}

/* ========== 操作提示 ========== */
.map-tip {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 16rpx;
}

/* ========== 图例 ========== */
.legend {
  margin-top: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx;
}

.legend-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
  margin-bottom: 16rpx;
}

.legend-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  margin-bottom: 8rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.legend-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* ========== 详情弹窗 ========== */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.detail-overlay.show {
  opacity: 1;
  visibility: visible;
}

.detail-card {
  width: 100%;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 30rpx 50rpx;
  transform: translateY(100%);
  transition: transform 0.35s ease;
}

.detail-overlay.show .detail-card {
  transform: translateY(0);
}

.detail-header {
  border-left: 6rpx solid;
  padding-left: 20rpx;
  margin-bottom: 28rpx;
}

.detail-room-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
  margin-bottom: 10rpx;
}

.detail-type-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.detail-body {
  margin-bottom: 32rpx;
}

.detail-info {
  margin-bottom: 20rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 6rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #374151;
  display: block;
  line-height: 1.5;
}

.detail-close {
  background-color: #1A73E8;
  color: #fff;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  cursor: pointer;
}

.detail-close:active {
  background-color: #1557b0;
}
