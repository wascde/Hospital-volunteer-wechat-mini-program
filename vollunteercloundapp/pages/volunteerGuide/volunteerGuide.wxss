/* pages/volunteerGuide/volunteerGuide.wxss */
.container {
  padding: 20rpx;
}

.nav-bar {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.nav-item {
  padding: 15rpx 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.nav-item.active {
  background-color: #1A73E8;
  color: #fff;
}

.content-section {
  margin-top: 20rpx;
}

.content-card {
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.content-item {
  margin-bottom: 25rpx;
}

.content-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
  color: #1A73E8;
}

.content-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
  display: block;
  margin-left: 10rpx;
  margin-bottom: 5rpx;
}