/* app.wxss */
/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
  font-size: 14px;
  line-height: 1.5;
}

/* 容器样式 */
.container {
  padding: 20rpx;
}

/* 标题样式 */
.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  margin-bottom: 20rpx;
}

/* 输入框样式 */
.input {
  border: 1rpx solid #ddd;
  border-radius: 5rpx;
  padding: 15rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

/* 按钮样式 */
.button {
  background-color: #1A73E8;
  color: #fff;
  border-radius: 5rpx;
  padding: 15rpx;
  text-align: center;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.button:hover {
  background-color: #1557b0;
}

/* 列表样式 */
.list {
  background-color: #fff;
}

.list-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.list-item:last-child {
  border-bottom: none;
}

/* 导航栏样式 */
.nav-bar {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.nav-item {
  text-align: center;
  padding: 10rpx;
}

.nav-item.active {
  color: #1A73E8;
  font-weight: bold;
}

/* 地图样式 */
.map-container {
  width: 100%;
  height: 500rpx;
  margin-bottom: 20rpx;
}